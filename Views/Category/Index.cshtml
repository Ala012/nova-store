@model IList<CategoryCardItem>
@{
    ViewData["Title"] = "Catégories";
    var canManage = User.IsInRole("Admin") || User.IsInRole("Manager");
}

<section class="page-hero page-hero-shop">
    <div class="container">
        <nav class="breadcrumb-line">
            <a asp-controller="Home" asp-action="Index">Accueil</a>
            <i class="bi bi-chevron-right"></i>
            <span>Catégories</span>
        </nav>
        <div class="page-hero-row">
            <div>
                <span class="eyebrow"><span class="eyebrow-dot"></span> Univers</span>
                <h1>Explorez par <span class="grad-text">catégorie</span></h1>
                <p>Chaque univers a été pensé pour vous faire gagner du temps.</p>
            </div>
            @if (canManage)
            {
                <a class="btn btn-gradient" asp-controller="Category" asp-action="Create"><i class="bi bi-plus-lg"></i> Nouvelle catégorie</a>
            }
        </div>
    </div>
</section>

<div class="container section">
    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <span class="empty-icon"><i class="bi bi-tags"></i></span>
            <h3>Aucune catégorie</h3>
            <p>Créez votre première catégorie pour organiser le catalogue.</p>
            @if (canManage)
            {
                <a class="btn btn-gradient" asp-controller="Category" asp-action="Create">Créer une catégorie</a>
            }
        </div>
    }
    else
    {
        <div class="category-showcase">
            @foreach (var item in Model)
            {
                <article class="category-panel reveal" style="--accent:@item.Category.Accent">
                    <div class="category-panel-top">
                        <span class="cat-icon cat-icon-lg"><i class="bi @item.Category.Icon"></i></span>
                        <span class="cat-count">@item.ProductCount produit@(item.ProductCount > 1 ? "s" : "")</span>
                    </div>
                    <h3>@item.Category.CategoryName</h3>
                    <p>@item.Category.Description</p>
                    <div class="category-panel-actions">
                        <a class="btn btn-ghost btn-sm" asp-controller="Product" asp-action="Index" asp-route-categoryId="@item.Category.CategoryId">
                            Explorer <i class="bi bi-arrow-right"></i>
                        </a>
                        @if (canManage)
                        {
                            <div class="table-actions">
                                <a class="icon-btn icon-btn-sm" asp-controller="Category" asp-action="Edit" asp-route-id="@item.Category.CategoryId" title="Modifier"><i class="bi bi-pencil"></i></a>
                                <a class="icon-btn icon-btn-sm icon-btn-danger" asp-controller="Category" asp-action="Delete" asp-route-id="@item.Category.CategoryId" title="Supprimer"><i class="bi bi-trash3"></i></a>
                            </div>
                        }
                    </div>
                </article>
            }
        </div>
    }
</div>
