@model List<Product>
@{
    ViewData["Title"] = "Gérer les produits";
}

<div class="container admin-page">
    <div class="admin-header">
        <div>
            <nav class="breadcrumb-line">
                <a asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                <i class="bi bi-chevron-right"></i>
                <span>Produits</span>
            </nav>
            <h1>Gestion des <span class="grad-text">produits</span></h1>
            <p>@(ViewBag.Search is string s && !string.IsNullOrWhiteSpace(s) ? $"Résultats pour « {s} »." : "Gérez votre catalogue, votre stock et vos mises en avant.")</p>
        </div>
        <a class="btn btn-gradient" asp-controller="Product" asp-action="Create"><i class="bi bi-plus-lg"></i> Nouveau produit</a>
    </div>

    <div class="table-card">
        <div class="table-toolbar">
            <form method="get" asp-controller="Product" asp-action="Manage" class="table-search">
                <i class="bi bi-search"></i>
                <input type="search" name="q" value="@ViewBag.Search" placeholder="Rechercher un produit…" />
                <select name="categoryId" asp-items="ViewBag.CategoryId" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">Toutes catégories</option>
                </select>
                <button type="submit" class="btn btn-ghost btn-sm">Filtrer</button>
            </form>
            <span class="table-count">@Model.Count produit@(Model.Count > 1 ? "s" : "")</span>
        </div>

        @if (Model.Count == 0)
        {
            <div class="empty-state empty-state-sm">
                <span class="empty-icon"><i class="bi bi-box-seam"></i></span>
                <h3>Aucun produit</h3>
                <p>Ajoutez votre premier produit pour démarrer la vente.</p>
                <a class="btn btn-gradient" asp-controller="Product" asp-action="Create">Créer un produit</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table nova-table align-middle">
                    <thead>
                        <tr>
                            <th>Produit</th>
                            <th>Catégorie</th>
                            <th>Prix</th>
                            <th>Stock</th>
                            <th>Note</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in Model)
                        {
                            <tr>
                                <td>
                                    <div class="table-product">
                                        <img src="@Url.Content("~/images/" + product.Image)" alt="@product.Name" />
                                        <div>
                                            <strong>@product.Name</strong>
                                            <small>NOVA-@product.ProductId.ToString("D4")</small>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="cat-badge" style="--accent:@(product.Category?.Accent ?? "#6d5efc")">@product.Category?.CategoryName</span></td>
                                <td>
                                    <strong>@Money.Format(product.Price)</strong>
                                    @if (product.OldPrice.HasValue)
                                    {
                                        <small class="d-block text-muted text-decoration-line-through">@Money.Format(product.OldPrice.Value)</small>
                                    }
                                </td>
                                <td>
                                    <span class="stock-pill @(product.QteStock == 0 ? "stock-out" : product.QteStock <= 5 ? "stock-low" : "stock-ok")">
                                        <span class="stock-dot"></span> @product.QteStock
                                    </span>
                                </td>
                                <td>
                                    <span class="table-rating"><i class="bi bi-star-fill"></i> @product.RatingAverage.ToString("0.0")</span>
                                    <small class="d-block text-muted">@product.RatingCount avis</small>
                                </td>
                                <td class="text-end">
                                    <div class="table-actions">
                                        <a class="icon-btn icon-btn-sm" asp-controller="Product" asp-action="Details" asp-route-id="@product.ProductId" title="Voir"><i class="bi bi-eye"></i></a>
                                        <a class="icon-btn icon-btn-sm" asp-controller="Product" asp-action="Edit" asp-route-id="@product.ProductId" title="Modifier"><i class="bi bi-pencil"></i></a>
                                        <a class="icon-btn icon-btn-sm icon-btn-danger" asp-controller="Product" asp-action="Delete" asp-route-id="@product.ProductId" title="Supprimer"><i class="bi bi-trash3"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
