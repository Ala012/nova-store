@model CreateViewModel
@{
    var existing = Model is EditViewModel edit ? edit.ExistingImagePath : null;
    var preview = string.IsNullOrEmpty(existing) ? Url.Content("~/images/products/default.svg") : Url.Content("~/images/" + existing);
}

<div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="panel">
            <h5 class="panel-title"><i class="bi bi-info-circle"></i> Informations produit</h5>

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" placeholder="Ex : Casque NovaSound Pro" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="CategoryId" class="form-label"></label>
                <select asp-for="CategoryId" asp-items="ViewBag.CategoryId" class="form-select">
                    <option value="">— Choisir une catégorie —</option>
                </select>
                <span asp-validation-for="CategoryId" class="text-danger small"></span>
            </div>

            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="Price" class="form-label"></label>
                    <input asp-for="Price" class="form-control" type="number" step="0.001" min="0" />
                    <span asp-validation-for="Price" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="OldPrice" class="form-label"></label>
                    <input asp-for="OldPrice" class="form-control" type="number" step="0.001" min="0" />
                    <span asp-validation-for="OldPrice" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="QteStock" class="form-label"></label>
                    <input asp-for="QteStock" class="form-control" type="number" min="0" />
                    <span asp-validation-for="QteStock" class="text-danger small"></span>
                </div>
            </div>

            <div class="mt-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="5" maxlength="1200"
                          placeholder="Décrivez le produit, ses points forts, ses caractéristiques…"></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="panel">
            <h5 class="panel-title"><i class="bi bi-image"></i> Visuel</h5>

            <div class="image-upload" data-image-upload>
                <img src="@preview" alt="Aperçu du produit" id="imagePreview" />
                <label class="image-upload-btn" for="ImagePath">
                    <i class="bi bi-camera"></i> Choisir une image
                </label>
                <input asp-for="ImagePath" type="file" accept="image/*" id="ImagePath" class="image-input" data-image-input />
            </div>
            <p class="field-hint">JPG, PNG, WEBP, GIF ou SVG · 6 Mo maximum. Laissez vide pour conserver l'image actuelle.</p>
            <span asp-validation-for="ImagePath" class="text-danger small"></span>
        </div>

        <div class="panel">
            <h5 class="panel-title"><i class="bi bi-stars"></i> Mise en avant</h5>
            <label class="switch-row">
                <input asp-for="IsFeatured" type="checkbox" />
                <span class="switch-ui"></span>
                <span><strong>Produit vedette</strong><small>Affiché sur la page d'accueil</small></span>
            </label>
            <label class="switch-row">
                <input asp-for="IsNew" type="checkbox" />
                <span class="switch-ui"></span>
                <span><strong>Nouveauté</strong><small>Badge « Nouveau » sur la fiche</small></span>
            </label>
        </div>
    </div>
</div>
