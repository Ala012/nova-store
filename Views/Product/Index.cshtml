@model ProductListViewModel
@{
    var f = Model.Filter;
    var httpContext = ViewContext.HttpContext;
    var baseParams = httpContext.Request.Query
        .Where(kv => kv.Key != "page")
        .SelectMany(kv => kv.Value.Select(v => $"{Uri.EscapeDataString(kv.Key)}={Uri.EscapeDataString(v ?? string.Empty)}"));
    var baseQuery = string.Join("&", baseParams);
    string PageUrl(int page) => $"{httpContext.Request.Path}?{(string.IsNullOrEmpty(baseQuery) ? string.Empty : baseQuery + "&")}page={page}";

    var pages = new List<int>();
    var startPage = Math.Max(1, Model.Result.Page - 2);
    var endPage = Math.Min(Model.Result.TotalPages, Model.Result.Page + 2);
    if (startPage > 1)
    {
        pages.Add(1);
        if (startPage > 2) pages.Add(-1);
    }
    for (var p = startPage; p <= endPage; p++) pages.Add(p);
    if (endPage < Model.Result.TotalPages)
    {
        if (endPage < Model.Result.TotalPages - 1) pages.Add(-1);
        pages.Add(Model.Result.TotalPages);
    }
}

<section class="page-hero page-hero-shop">
    <div class="container">
        <nav class="breadcrumb-line" aria-label="Fil d'ariane">
            <a asp-controller="Home" asp-action="Index">Accueil</a>
            <i class="bi bi-chevron-right"></i>
            <span>Boutique</span>
            @if (!string.IsNullOrEmpty(Model.CategoryName))
            {
                <i class="bi bi-chevron-right"></i>
                <span>@Model.CategoryName</span>
            }
        </nav>
        <div class="page-hero-row">
            <div>
                <span class="eyebrow"><span class="eyebrow-dot"></span> Catalogue</span>
                <h1>@(Model.CategoryName ?? "Toute la boutique")</h1>
                <p>
                    @if (!string.IsNullOrWhiteSpace(f.Search))
                    {
                        <span>Résultats pour « <strong>@f.Search</strong> » — </span>
                    }
                    @Model.Result.TotalCount produit@(Model.Result.TotalCount > 1 ? "s" : "") à découvrir.
                </p>
            </div>
            <div class="page-hero-art" aria-hidden="true">
                <i class="bi bi-bag-heart"></i>
            </div>
        </div>
    </div>
</section>

<div class="container shop-layout">
    <aside class="shop-sidebar" id="sidebar">
        <div class="filter-card">
            <div class="filter-head">
                <div>
                    <span class="eyebrow"><span class="eyebrow-dot"></span> Filtrer</span>
                    <h5>Affiner la sélection</h5>
                </div>
                <a class="filter-reset" asp-controller="Product" asp-action="Index" title="Réinitialiser">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>

            <h6 class="filter-label">Catégories</h6>
            @await Component.InvokeAsync("Categories")

            <form method="get" asp-controller="Product" asp-action="Index" class="filter-form">
                @if (!string.IsNullOrWhiteSpace(f.Search))
                {
                    <input type="hidden" name="q" value="@f.Search" />
                }
                @if (f.CategoryId.HasValue)
                {
                    <input type="hidden" name="categoryId" value="@f.CategoryId" />
                }
                @if (!string.IsNullOrWhiteSpace(f.Sort))
                {
                    <input type="hidden" name="sort" value="@f.Sort" />
                }

                <h6 class="filter-label">Budget (DT)</h6>
                <div class="price-range">
                    <input type="number" name="min" min="0" step="1" placeholder="@Model.MinCatalogPrice.ToString("0")" value="@f.MinPrice" aria-label="Prix minimum" />
                    <span>—</span>
                    <input type="number" name="max" min="0" step="1" placeholder="@Model.MaxCatalogPrice.ToString("0")" value="@f.MaxPrice" aria-label="Prix maximum" />
                </div>
                <p class="filter-hint">Catalogue : @Money.FormatShort(Model.MinCatalogPrice) à @Money.FormatShort(Model.MaxCatalogPrice)</p>

                <div class="filter-checks">
                    <label class="form-check nova-check">
                        <input class="form-check-input" type="checkbox" name="promo" value="true" checked="@f.OnlyPromo" />
                        <span class="form-check-label">Uniquement les promos</span>
                    </label>
                    <label class="form-check nova-check">
                        <input class="form-check-input" type="checkbox" name="stock" value="true" checked="@f.InStockOnly" />
                        <span class="form-check-label">En stock seulement</span>
                    </label>
                </div>

                <button type="submit" class="btn btn-gradient w-100">
                    <i class="bi bi-funnel"></i> Appliquer les filtres
                </button>
            </form>
        </div>

        <div class="sidebar-help">
            <span class="sidebar-help-icon"><i class="bi bi-chat-dots"></i></span>
            <h6>Besoin d'un conseil ?</h6>
            <p>Notre équipe vous répond 7j/7 pour vous aider à choisir.</p>
            <a href="mailto:hello@nova.tn">hello@nova.tn <i class="bi bi-arrow-right"></i></a>
        </div>
    </aside>

    <div class="shop-main" id="mainContent">
        <div class="shop-toolbar">
            <div class="shop-toolbar-info">
                <button type="button" class="btn btn-ghost btn-sm shop-filter-toggle" id="toggleSidebar">
                    <i class="bi bi-sliders"></i> Filtres
                </button>
                <span><strong>@Model.Result.TotalCount</strong> résultat@(Model.Result.TotalCount > 1 ? "s" : "")</span>
                @if (Model.Result.TotalPages > 1)
                {
                    <span class="toolbar-page">Page @Model.Result.Page / @Model.Result.TotalPages</span>
                }
            </div>

            <form method="get" asp-controller="Product" asp-action="Index" class="sort-form">
                @if (!string.IsNullOrWhiteSpace(f.Search))
                {
                    <input type="hidden" name="q" value="@f.Search" />
                }
                @if (f.CategoryId.HasValue)
                {
                    <input type="hidden" name="categoryId" value="@f.CategoryId" />
                }
                @if (f.MinPrice.HasValue)
                {
                    <input type="hidden" name="min" value="@f.MinPrice" />
                }
                @if (f.MaxPrice.HasValue)
                {
                    <input type="hidden" name="max" value="@f.MaxPrice" />
                }
                @if (f.OnlyPromo)
                {
                    <input type="hidden" name="promo" value="true" />
                }
                @if (f.InStockOnly)
                {
                    <input type="hidden" name="stock" value="true" />
                }
                <label for="sortSelect">Trier par</label>
                <select id="sortSelect" name="sort" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="" selected="@(string.IsNullOrEmpty(f.Sort))">Pertinence</option>
                    <option value="new" selected="@(f.Sort == "new")">Nouveautés</option>
                    <option value="price-asc" selected="@(f.Sort == "price-asc")">Prix croissant</option>
                    <option value="price-desc" selected="@(f.Sort == "price-desc")">Prix décroissant</option>
                    <option value="rating" selected="@(f.Sort == "rating")">Meilleures notes</option>
                    <option value="name" selected="@(f.Sort == "name")">Nom A → Z</option>
                </select>
            </form>
        </div>

        @if (Model.Result.Items.Count == 0)
        {
            <div class="empty-state empty-state-lg">
                <span class="empty-icon"><i class="bi bi-search"></i></span>
                <h3>Aucun produit trouvé</h3>
                <p>Essayez d'élargir vos filtres ou de rechercher un autre mot-clé.</p>
                <a class="btn btn-gradient" asp-controller="Product" asp-action="Index">Réinitialiser la recherche</a>
            </div>
        }
        else
        {
            <div class="product-grid">
                @foreach (var product in Model.Result.Items)
                {
                    <partial name="_ProductCard" model="product" />
                }
            </div>

            @if (Model.Result.TotalPages > 1)
            {
                <nav class="pagination-wrap" aria-label="Pagination des produits">
                    <a class="page-btn page-arrow @(Model.Result.HasPrevious ? null : "disabled")"
                       href="@(Model.Result.HasPrevious ? PageUrl(Model.Result.Page - 1) : "#")"
                       aria-label="Page précédente">
                        <i class="bi bi-chevron-left"></i>
                    </a>

                    @foreach (var page in pages)
                    {
                        if (page == -1)
                        {
                            <span class="page-ellipsis">…</span>
                        }
                        else
                        {
                            <a class="page-btn @(page == Model.Result.Page ? "active" : null)" href="@PageUrl(page)">@(page)</a>
                        }
                    }

                    <a class="page-btn page-arrow @(Model.Result.HasNext ? null : "disabled")"
                       href="@(Model.Result.HasNext ? PageUrl(Model.Result.Page + 1) : "#")"
                       aria-label="Page suivante">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </nav>
            }
        }
    </div>
</div>
