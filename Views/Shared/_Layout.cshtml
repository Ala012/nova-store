@{
    var pageTitle = ViewData["Title"] as string;
    var fullTitle = string.IsNullOrWhiteSpace(pageTitle) ? "NOVA — Boutique en ligne" : $"{pageTitle} · NOVA";
}
<!DOCTYPE html>
<html lang="fr" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="NOVA — la boutique en ligne qui réunit tech, design et lifestyle. Livraison rapide partout en Tunisie." />
    <title>@fullTitle</title>
    <script>
        (function () {
            try {
                var t = localStorage.getItem('nova-theme');
                if (!t) t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
                document.documentElement.setAttribute('data-theme', t);
            } catch (e) { }
        })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Sora:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/nova.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <a class="skip-link" href="#main">Aller au contenu</a>
    <div class="page-aurora" aria-hidden="true"></div>

    <div class="announcement-bar">
        <div class="container announcement-inner">
            <span><i class="bi bi-truck"></i> Livraison offerte dès 299 DT</span>
            <span class="announcement-mid"><i class="bi bi-arrow-repeat"></i> Retours gratuits sous 30 jours</span>
            <span><i class="bi bi-shield-check"></i> Paiement 100% sécurisé</span>
        </div>
    </div>

    <header class="site-header" id="siteHeader">
        <nav class="navbar navbar-expand-xl nova-navbar">
            <div class="container">
                <a class="navbar-brand nova-brand" asp-controller="Home" asp-action="Index" aria-label="NOVA, accueil">
                    <span class="brand-mark">N</span>
                    <span class="brand-word">NOVA<span class="brand-dot">.</span></span>
                </a>

                <button class="navbar-toggler nova-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#novaNav"
                        aria-controls="novaNav" aria-expanded="false" aria-label="Ouvrir le menu">
                    <i class="bi bi-list"></i>
                </button>

                <div class="collapse navbar-collapse" id="novaNav">
                    <ul class="navbar-nav nova-nav-links me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Accueil</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Product" asp-action="Index">Boutique</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Product" asp-action="Index" asp-route-sort="new">Nouveautés</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-hot" asp-controller="Product" asp-action="Index" asp-route-promo="true">
                                Promos <span class="hot-dot"></span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link nav-link-btn" type="button" id="categoriesNavBtn">
                                Catégories <i class="bi bi-chevron-down"></i>
                            </button>
                        </li>
                        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                        {
                            <li class="nav-item">
                                <a class="nav-link nav-link-admin" asp-controller="Dashboard" asp-action="Index">
                                    <i class="bi bi-speedometer2"></i> Dashboard
                                </a>
                            </li>
                        }
                    </ul>

                    <form class="nova-search" asp-controller="Product" asp-action="Search" method="get" role="search">
                        <i class="bi bi-search"></i>
                        <input type="search" name="val" id="globalSearch" placeholder="Rechercher un produit…" autocomplete="off" aria-label="Rechercher" />
                        <kbd>/</kbd>
                    </form>

                    <div class="nova-actions">
                        <button class="icon-btn" type="button" id="toggleMenu" title="Afficher les catégories" aria-label="Afficher les catégories">
                            <i class="bi bi-layout-sidebar-inset"></i>
                        </button>
                        <button class="icon-btn" type="button" id="themeToggle" title="Changer de thème" aria-label="Changer de thème">
                            <i class="bi bi-moon-stars theme-icon-moon"></i>
                            <i class="bi bi-brightness-high theme-icon-sun"></i>
                        </button>
                        <a class="icon-btn" asp-controller="Wishlist" asp-action="Index" title="Mes favoris" aria-label="Mes favoris">
                            <i class="bi bi-heart"></i>
                            <span id="wishlistBadge">@await Component.InvokeAsync("WishlistBadge")</span>
                        </a>
                        <a class="icon-btn cart-icon-btn" asp-controller="Panier" asp-action="Index" title="Mon panier" aria-label="Mon panier">
                            <i class="bi bi-bag"></i>
                            <span id="cartBadge">@await Component.InvokeAsync("CartBadge")</span>
                        </a>
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main id="main" role="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="footer-top">
                <div class="footer-brand">
                    <a class="nova-brand" asp-controller="Home" asp-action="Index">
                        <span class="brand-mark">N</span>
                        <span class="brand-word">NOVA<span class="brand-dot">.</span></span>
                    </a>
                    <p>Tech, design et lifestyle réunis dans une seule adresse. Nous sélectionnons des produits qui rendent le quotidien plus beau.</p>
                    <div class="footer-socials">
                        <a href="#" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
                        <a href="#" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                        <a href="#" aria-label="TikTok"><i class="bi bi-tiktok"></i></a>
                        <a href="#" aria-label="YouTube"><i class="bi bi-youtube"></i></a>
                    </div>
                </div>
                <div class="footer-col">
                    <h6>Boutique</h6>
                    <a asp-controller="Product" asp-action="Index">Tous les produits</a>
                    <a asp-controller="Product" asp-action="Index" asp-route-sort="new">Nouveautés</a>
                    <a asp-controller="Product" asp-action="Index" asp-route-promo="true">Promotions</a>
                    <a asp-controller="Category" asp-action="Index">Catégories</a>
                </div>
                <div class="footer-col">
                    <h6>Mon compte</h6>
                    <a asp-controller="Account" asp-action="Profile">Mon profil</a>
                    <a asp-controller="Orders" asp-action="MyOrders">Mes commandes</a>
                    <a asp-controller="Wishlist" asp-action="Index">Mes favoris</a>
                    <a asp-controller="Panier" asp-action="Index">Mon panier</a>
                </div>
                <div class="footer-newsletter">
                    <h6>La newsletter NOVA</h6>
                    <p>Offres privées, nouveautés et inspirations. Pas de spam, promis.</p>
                    <form class="newsletter-form" id="newsletterForm">
                        <input type="email" placeholder="votre@email.com" required aria-label="Votre e-mail" />
                        <button type="submit" class="btn btn-gradient" aria-label="S'abonner"><i class="bi bi-arrow-right"></i></button>
                    </form>
                    <div class="footer-payments">
                        <span><i class="bi bi-credit-card-2-front"></i> Visa</span>
                        <span><i class="bi bi-paypal"></i> PayPal</span>
                        <span><i class="bi bi-cash-coin"></i> À la livraison</span>
                    </div>
                </div>
            </div>
            <div class="footer-bottom">
                <span>© @DateTime.Now.Year NOVA. Tous droits réservés.</span>
                <span class="footer-legal">
                    <a href="#">Conditions</a>
                    <a href="#">Confidentialité</a>
                    <a href="#">Cookies</a>
                </span>
            </div>
        </div>
    </footer>

    <div class="offcanvas offcanvas-end nova-offcanvas" tabindex="-1" id="categoriesDrawer" aria-labelledby="categoriesDrawerLabel">
        <div class="offcanvas-header">
            <div>
                <span class="eyebrow"><span class="eyebrow-dot"></span> Explorer</span>
                <h5 class="offcanvas-title mt-2" id="categoriesDrawerLabel">Toutes les catégories</h5>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Fermer"></button>
        </div>
        <div class="offcanvas-body">
            @await Component.InvokeAsync("Categories")
            <div class="drawer-cta">
                <i class="bi bi-stars"></i>
                <div>
                    <strong>Une sélection pensée pour vous</strong>
                    <p>Des produits choisis pour leur qualité et leur design.</p>
                    <a asp-controller="Product" asp-action="Index" class="btn btn-gradient btn-sm">Voir la boutique</a>
                </div>
            </div>
        </div>
    </div>

    <div class="toast-stack" id="toastStack" aria-live="polite" aria-atomic="true">
        @if (TempData["Success"] is string success)
        {
            <div class="nova-toast toast-success" role="status">
                <i class="bi bi-check2-circle"></i>
                <span>@success</span>
                <button type="button" class="toast-close" aria-label="Fermer"><i class="bi bi-x"></i></button>
            </div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="nova-toast toast-error" role="alert">
                <i class="bi bi-exclamation-triangle"></i>
                <span>@error</span>
                <button type="button" class="toast-close" aria-label="Fermer"><i class="bi bi-x"></i></button>
            </div>
        }
        @if (TempData["Info"] is string info)
        {
            <div class="nova-toast toast-info" role="status">
                <i class="bi bi-info-circle"></i>
                <span>@info</span>
                <button type="button" class="toast-close" aria-label="Fermer"><i class="bi bi-x"></i></button>
            </div>
        }
    </div>

    <button type="button" class="back-to-top" id="backToTop" aria-label="Remonter en haut">
        <i class="bi bi-arrow-up"></i>
    </button>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/nova.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
