@model ManageOrdersViewModel
@{
    ViewData["Title"] = "Gérer les commandes";
    var statuses = OrderStatuses.All;
    var currentUrl = Context.Request.Path + Context.Request.QueryString;
}

<div class="container admin-page">
    <div class="admin-header">
        <div>
            <nav class="breadcrumb-line">
                <a asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                <i class="bi bi-chevron-right"></i>
                <span>Commandes</span>
            </nav>
            <h1>Gestion des <span class="grad-text">commandes</span></h1>
            <p>Suivez, confirmez et expédiez les commandes de vos clients.</p>
        </div>
        <a class="btn btn-ghost" asp-controller="Orders" asp-action="Manage"><i class="bi bi-arrow-clockwise"></i> Actualiser</a>
    </div>

    <div class="mini-kpis">
        <div class="mini-kpi"><span class="mini-kpi-icon" style="--i:#6d5efc"><i class="bi bi-receipt"></i></span><div><strong>@Model.Total</strong><small>Total</small></div></div>
        <div class="mini-kpi"><span class="mini-kpi-icon" style="--i:#f59e0b"><i class="bi bi-hourglass-split"></i></span><div><strong>@Model.Pending</strong><small>En attente</small></div></div>
        <div class="mini-kpi"><span class="mini-kpi-icon" style="--i:#10b981"><i class="bi bi-check2-circle"></i></span><div><strong>@Model.Delivered</strong><small>Livrées</small></div></div>
        <div class="mini-kpi"><span class="mini-kpi-icon" style="--i:#ff5c7a"><i class="bi bi-x-circle"></i></span><div><strong>@Model.Cancelled</strong><small>Annulées</small></div></div>
    </div>

    <div class="filter-tabs">
        <a class="filter-tab @(string.IsNullOrEmpty(Model.Status) || Model.Status == "all" ? "active" : null)" asp-controller="Orders" asp-action="Manage">Toutes</a>
        @foreach (var status in statuses)
        {
            <a class="filter-tab @(Model.Status == status ? "active" : null)" asp-controller="Orders" asp-action="Manage" asp-route-status="@status">@status</a>
        }
    </div>

    <div class="table-card">
        @if (Model.Orders.Count == 0)
        {
            <div class="empty-state empty-state-sm">
                <span class="empty-icon"><i class="bi bi-inbox"></i></span>
                <h3>Aucune commande</h3>
                <p>Aucune commande ne correspond à ce filtre.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table nova-table align-middle">
                    <thead>
                        <tr>
                            <th>Commande</th>
                            <th>Client</th>
                            <th>Date</th>
                            <th>Articles</th>
                            <th>Total</th>
                            <th>Statut</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model.Orders)
                        {
                            <tr>
                                <td><strong>#@order.Id.ToString("D5")</strong></td>
                                <td>
                                    <div class="customer-cell">
                                        <span class="review-avatar" style="--i:#6d5efc">@DisplayText.Initials(order.CustomerName)</span>
                                        <div>
                                            <strong>@order.CustomerName</strong>
                                            <small>@order.Email</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span>@order.OrderDate.ToString("dd/MM/yyyy")</span>
                                    <small class="d-block text-muted">@order.OrderDate.ToString("HH:mm")</small>
                                </td>
                                <td>@order.Items.Sum(i => i.Quantity)</td>
                                <td><strong>@Money.Format(order.TotalAmount)</strong></td>
                                <td><span class="status-badge @OrderStatuses.CssClass(order.Status)">@order.Status</span></td>
                                <td class="text-end">
                                    <div class="order-manage-actions">
                                        <a class="icon-btn icon-btn-sm" asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id" title="Voir"><i class="bi bi-eye"></i></a>
                                        <form asp-controller="Orders" asp-action="UpdateStatus" method="post" class="status-form">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="orderId" value="@order.Id" />
                                            <input type="hidden" name="returnUrl" value="@currentUrl" />
                                            <select name="status" class="form-select form-select-sm">
                                                @foreach (var status in statuses)
                                                {
                                                    <option value="@status" selected="@(status == order.Status)">@status</option>
                                                }
                                            </select>
                                            <button type="submit" class="btn btn-ghost btn-sm" title="Mettre à jour"><i class="bi bi-check2"></i></button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
